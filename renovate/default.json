{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset of the enshwick repositories, extended as github>enshwick/.github//renovate/default.",
  "extends": [
    "config:best-practices",
    ":semanticCommits"
  ],
  "timezone": "Europe/Kyiv",
  "platformCommit": "enabled",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "The shared workflows and actions of enshwick/.github stay on main: the organization runners accept only workflows from main, so a pin to a commit would stop the jobs.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "enshwick/.github"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "/^wasmtime/"
      ],
      "groupName": "wasmtime"
    },
    {
      "description": "Our own crates: picked up on the next run, prereleases included while the platform is in alpha, all in one update.",
      "matchPackageNames": [
        "/^enshwick(-|$)/",
        "cargo-enshwick"
      ],
      "schedule": [
        "at any time"
      ],
      "minimumReleaseAge": null,
      "groupName": "enshwick",
      "ignoreUnstable": false,
      "respectLatest": false,
      "rangeStrategy": "bump"
    },
    {
      "description": "Its last release is from January 2024; the dashboard flags it once a year passes without one.",
      "matchPackageNames": [
        "iced-x86"
      ],
      "abandonmentThreshold": "1 year"
    },
    {
      "description": "The toolchain and rust-version move together and bring new lints, so a person merges them.",
      "matchDepNames": [
        "rust"
      ],
      "groupName": "Rust toolchain",
      "automerge": false
    },
    {
      "description": "Tools CI installs through taiki-e/install-action: a version its manifests lack yet falls back to cargo-binstall, which fails on the runners, so a new version waits until install-action has it.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "crate"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "The dedicated server's pins in image.toml wait three days. A new GE-Proton also needs its sha512 written by hand, so it never merges on its own.",
      "matchFileNames": [
        "**/image.toml",
        "image.toml"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchDepNames": [
        "GloriousEggroll/proton-ge-custom"
      ],
      "automerge": false
    },
    {
      "description": "Tools pinned with a checksum in the composite actions wait three days, as the cargo tools do, so the Windows and Linux jobs move together.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "rust-cross/cargo-xwin",
        "mozilla/sccache",
        "nextest-rs/nextest",
        "EmbarkStudios/cargo-deny",
        "llvm/llvm-project",
        "cli/cli"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "sccache and LLVM in the composite actions get a new tag but not its SHA-256, which a person writes in; the checksum step fails until then.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "mozilla/sccache",
        "llvm/llvm-project"
      ],
      "automerge": false
    },
    {
      "description": "LLVM follows the major of the Rust toolchain's own LLVM and moves with the toolchain, by hand.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "llvm/llvm-project"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "rust-version, the toolchain's major and minor, beside the built-in rust-toolchain manager.",
      "managerFilePatterns": [
        "/(^|/)Cargo\\.toml$/"
      ],
      "matchStrings": [
        "rust-version\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "rust",
      "packageNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+)"
    },
    {
      "customType": "regex",
      "description": "Cargo tools installed in workflows and composite actions, and named in the docs.",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/.+\\.ya?ml$/",
        "/(^|/)\\.github/actions/.+/action\\.ya?ml$/",
        "/\\.md$/"
      ],
      "matchStrings": [
        "(?:tool:\\s*|,|cargo install --locked )(?<depName>cargo-[a-z0-9-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "description": "The nightly toolchain date in workflows.",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "nightly-(?<currentValue>\\d{4}-\\d{2}-\\d{2})"
      ],
      "depNameTemplate": "rust-nightly",
      "datasourceTemplate": "custom.rust-nightly",
      "versioningTemplate": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$"
    },
    {
      "customType": "regex",
      "description": "The base image of the dedicated server, by tag and digest, in image.toml.",
      "managerFilePatterns": [
        "/(^|/)image\\.toml$/"
      ],
      "matchStrings": [
        "base = \"(?<depName>[^:\"]+):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "base = \"{{depName}}:{{newValue}}@{{newDigest}}\""
    },
    {
      "customType": "regex",
      "description": "The GE-Proton build of the dedicated server image, version and download, in image.toml.",
      "managerFilePatterns": [
        "/(^|/)image\\.toml$/"
      ],
      "matchStrings": [
        "version = \"(?<currentValue>GE-Proton\\d+-\\d+)\"\\nurl = \"[^\"]*\""
      ],
      "depNameTemplate": "GloriousEggroll/proton-ge-custom",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^GE-Proton(?<major>\\d+)-(?<minor>\\d+)$",
      "autoReplaceStringTemplate": "version = \"{{newValue}}\"\nurl = \"https://github.com/GloriousEggroll/proton-ge-custom/releases/download/{{newValue}}/{{newValue}}-x86_64.tar.gz\""
    },
    {
      "customType": "regex",
      "description": "The GE-Proton whose Wine setup-rust sets up: release tag and the SHA-512 of its download, updated together.",
      "managerFilePatterns": [
        "/(^|/)\\.github/actions/.+/action\\.ya?ml$/"
      ],
      "matchStrings": [
        "GE_PROTON: (?<currentValue>GE-Proton\\d+-\\d+)\\s+GE_PROTON_SHA512: (?<currentDigest>[a-f0-9]{128})"
      ],
      "depNameTemplate": "GloriousEggroll/proton-ge-custom",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "regex:^GE-Proton(?<major>\\d+)-(?<minor>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "rust-cross/cargo-xwin in the composite actions: release tag and the SHA-256 of its download, updated together.",
      "managerFilePatterns": [
        "/(^|/)\\.github/actions/.+/action\\.ya?ml$/"
      ],
      "matchStrings": [
        "XWIN_TAG: (?<currentValue>v\\d+\\.\\d+\\.\\d+)\\s+XWIN_SHA256: (?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "rust-cross/cargo-xwin",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "nextest-rs/nextest in the composite actions: release tag and the SHA-256 of its download, updated together.",
      "managerFilePatterns": [
        "/(^|/)\\.github/actions/.+/action\\.ya?ml$/"
      ],
      "matchStrings": [
        "NEXTEST_TAG: (?<currentValue>cargo-nextest-\\d+\\.\\d+\\.\\d+)\\s+NEXTEST_SHA256: (?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "nextest-rs/nextest",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "regex:^cargo-nextest-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "EmbarkStudios/cargo-deny in the composite actions: release tag and the SHA-256 of its download, updated together.",
      "managerFilePatterns": [
        "/(^|/)\\.github/actions/.+/action\\.ya?ml$/"
      ],
      "matchStrings": [
        "DENY_TAG: (?<currentValue>\\d+\\.\\d+\\.\\d+)\\s+DENY_SHA256: (?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "EmbarkStudios/cargo-deny",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "cli/cli in the composite actions: release tag and the SHA-256 of its download, updated together.",
      "managerFilePatterns": [
        "/(^|/)\\.github/actions/.+/action\\.ya?ml$/"
      ],
      "matchStrings": [
        "GH_TAG: (?<currentValue>v\\d+\\.\\d+\\.\\d+)\\s+GH_SHA256: (?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "cli/cli",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "mozilla/sccache in the composite actions: the release tag only, since its checksum files hold no file name and Renovate would hash the checksum file instead of the download.",
      "managerFilePatterns": [
        "/(^|/)\\.github/actions/.+/action\\.ya?ml$/"
      ],
      "matchStrings": [
        "SCCACHE_TAG: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "mozilla/sccache",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "llvm/llvm-project in the composite actions: the release tag only, since its releases carry no checksum files and Renovate would download gigabytes to find one.",
      "managerFilePatterns": [
        "/(^|/)\\.github/actions/.+/action\\.ya?ml$/"
      ],
      "matchStrings": [
        "LLVM_TAG: (?<currentValue>llvmorg-\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "llvm/llvm-project",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^llvmorg-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "customDatasources": {
    "rust-nightly": {
      "defaultRegistryUrlTemplate": "https://static.rust-lang.org/dist/channel-rust-nightly-date.txt",
      "format": "plain"
    }
  }
}
