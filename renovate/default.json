{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset of the enshwick repositories, extended as github>enshwick/.github//renovate/default.",
  "extends": [
    "config:best-practices",
    ":semanticCommits"
  ],
  "timezone": "Europe/Kyiv",
  "dependencyDashboard": false,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "platformCommit": "enabled",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "The shared workflows and actions of enshwick/.github stay on main: the workflows check out their actions from main, so a pin to a commit would pair an old workflow with new actions.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "enshwick/.github"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "/^wasmtime/"
      ],
      "groupName": "wasmtime"
    },
    {
      "description": "Our own crates: picked up on the next run, prereleases included while the platform is in alpha, all in one update.",
      "matchPackageNames": [
        "/^enshwick(-|$)/",
        "cargo-enshwick"
      ],
      "schedule": [
        "at any time"
      ],
      "minimumReleaseAge": null,
      "groupName": "enshwick",
      "ignoreUnstable": false,
      "respectLatest": false,
      "rangeStrategy": "bump"
    },
    {
      "description": "Our mods build on the platform's main branch from git, pinned to a commit. Each Renovate run moves the commit to the newest on main, every platform crate of a repository in one pull request that merges once its checks pass.",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "git-refs"
      ],
      "matchPackageNames": [
        "https://github.com/enshwick/enshwick"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "schedule": [
        "at any time"
      ],
      "minimumReleaseAge": null,
      "groupName": "enshwick main",
      "automerge": true
    },
    {
      "description": "The toolchain and rust-version move together and bring new lints, so a person merges them.",
      "matchDepNames": [
        "rust"
      ],
      "groupName": "Rust toolchain",
      "automerge": false
    },
    {
      "description": "Crates pinned outside Cargo.lock wait three days. Most are tools CI installs through taiki-e/install-action, where a version its manifests lack yet falls back to cargo-binstall instead of the download install-action checks; the rest (cargo install pins, cache keys, generated manifests) take the same delay.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "crate"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "The dedicated server's pins in image.toml wait three days. A new GE-Proton also needs its sha512 written by hand, so it never merges on its own.",
      "matchFileNames": [
        "**/image.toml",
        "image.toml"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchDepNames": [
        "GloriousEggroll/proton-ge-custom"
      ],
      "automerge": false
    },
    {
      "description": "The GitHub CLI, pinned with a checksum in setup-rust, waits three days, as the cargo tools do.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "cli/cli"
      ],
      "minimumReleaseAge": "3 days"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "rust-version, the toolchain's major and minor, beside the built-in rust-toolchain manager. Cargo.toml.in is the manifest cargo enshwick new writes for a mod.",
      "managerFilePatterns": [
        "/(^|/)Cargo\\.toml(\\.in)?$/"
      ],
      "matchStrings": [
        "rust-version\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "rust",
      "packageNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+)"
    },
    {
      "customType": "regex",
      "description": "Cargo tools installed in workflows and composite actions, and named in the docs. Each is an exact version, so semver: under the crate datasource's cargo versioning 0.9.149 reads as ^0.9.149 and a patch never comes.",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/.+\\.ya?ml$/",
        "/(^|/)\\.github/actions/.+/action\\.ya?ml$/",
        "/\\.md$/"
      ],
      "matchStrings": [
        "(?:tools?:\\s*|TOOLS:\\s*|,|cargo install --locked )(?<depName>cargo-[a-z0-9-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "crate",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "The cache of the Windows SDK and CRT cargo-xwin downloads, keyed by the cargo-xwin version that filled it.",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "key: xwin-(?:release-)?\\$\\{\\{ runner\\.os \\}\\}-(?<currentValue>\\d+\\.\\d+\\.\\d+)-"
      ],
      "depNameTemplate": "cargo-xwin",
      "datasourceTemplate": "crate",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Wrangler, run through bunx in the site workflow and named in the schema URL of wrangler.jsonc.",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/.+\\.ya?ml$/",
        "/(^|/)wrangler\\.jsonc?$/"
      ],
      "matchStrings": [
        "WRANGLER_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "unpkg\\.com/wrangler@(?<currentValue>\\d+\\.\\d+\\.\\d+)/"
      ],
      "depNameTemplate": "wrangler",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "The crate versions in the manifest cargo enshwick new writes for a mod, which the cargo manager cannot parse for its placeholders.",
      "managerFilePatterns": [
        "/(^|/)Cargo\\.toml\\.in$/"
      ],
      "matchStrings": [
        "\\n(?<depName>[a-z0-9_-]+) = \\{ version = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "crate",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "The nightly toolchain date in workflows.",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "nightly-(?<currentValue>\\d{4}-\\d{2}-\\d{2})"
      ],
      "depNameTemplate": "rust-nightly",
      "datasourceTemplate": "custom.rust-nightly",
      "versioningTemplate": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$"
    },
    {
      "customType": "regex",
      "description": "The base image of the dedicated server, by tag and digest, in image.toml.",
      "managerFilePatterns": [
        "/(^|/)image\\.toml$/"
      ],
      "matchStrings": [
        "base = \"(?<depName>[^:\"]+):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "base = \"{{depName}}:{{newValue}}@{{newDigest}}\""
    },
    {
      "customType": "regex",
      "description": "The GE-Proton build of the dedicated server image, version and download, in image.toml.",
      "managerFilePatterns": [
        "/(^|/)image\\.toml$/"
      ],
      "matchStrings": [
        "version = \"(?<currentValue>GE-Proton\\d+-\\d+)\"\\nurl = \"[^\"]*\""
      ],
      "depNameTemplate": "GloriousEggroll/proton-ge-custom",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^GE-Proton(?<major>\\d+)-(?<minor>\\d+)$",
      "autoReplaceStringTemplate": "version = \"{{newValue}}\"\nurl = \"https://github.com/GloriousEggroll/proton-ge-custom/releases/download/{{newValue}}/{{newValue}}-x86_64.tar.gz\""
    },
    {
      "customType": "regex",
      "description": "cli/cli in the composite actions: release tag and the SHA-256 of its download, updated together.",
      "managerFilePatterns": [
        "/(^|/)\\.github/actions/.+/action\\.ya?ml$/"
      ],
      "matchStrings": [
        "GH_TAG: (?<currentValue>v\\d+\\.\\d+\\.\\d+)\\s+GH_SHA256: (?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "cli/cli",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "customDatasources": {
    "rust-nightly": {
      "defaultRegistryUrlTemplate": "https://static.rust-lang.org/dist/channel-rust-nightly-date.txt",
      "format": "plain"
    }
  }
}
